FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

RUN mkdir -p /data/uploads

# Concurrency of 4: PDF parsing/embedding is CPU-bound, entity extraction is
# I/O-bound on the LLM API, so a modest process pool keeps throughput high
# without oversubscribing memory (embedding model loaded once per process).
CMD ["celery", "-A", "app.infrastructure.celery.app.celery_app", "worker", "--loglevel=info", "--concurrency=4"]
